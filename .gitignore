# FastAPI / local settings
.env
.env.*
!.env.example

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# OS files
.DS_Store
Thumbs.db

# RAW DATA � keep locally, do not push
data/raw/*
!data/raw/.gitkeep

# Keep small/project metadata under raw data
!data/raw/admin/
!data/raw/admin/.gitkeep
!data/raw/disaster/
!data/raw/disaster/.gitkeep
!data/raw/rainfall/
!data/raw/rainfall/.gitkeep
!data/raw/dem/
!data/raw/dem/.gitkeep
!data/raw/settlements/
!data/raw/settlements/.gitkeep
!data/raw/shelters/
!data/raw/shelters/*.csv
!data/raw/shelters/*.md

# Large raw source files
*.nc
*.tif
*.tiff
*.hgt
*.zip
*.kmz

# Processed data
data/processed/*
!data/processed/.gitkeep

# Keep reproducible reports/documentation
!data/processed/*.md
!data/processed/*.json

# Keep project CSV outputs
!data/processed/*.csv

# Demo data
data/demo/*
!data/demo/.gitkeep
data/sensors.sqlite3*

# ML artifacts
model/artifacts/*
!model/artifacts/.gitkeep
!model/artifacts/spatial_susceptibility_xgboost.json
!model/artifacts/spatial_validation_metrics.json
