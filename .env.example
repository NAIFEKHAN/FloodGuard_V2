# Optional IMD forecast source. Leave empty to disable live fetches and keep
# the reliable manual rainfall Scenario Mode as the default safe fallback.
IMD_FORECAST_URL=
IMD_RAPID_FORECAST_URL=
IMD_REFRESH_HOURS=24
IMD_RAPID_REFRESH_HOURS=2

# Optional override for local cache directory. Default is data/cache.
IMD_CACHE_DIR=data/cache
